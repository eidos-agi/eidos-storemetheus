---
import { canonicalUrls, greenmarkStore } from '../lib/storemetheus';

const title = 'Greenmark Store';
const agentPrompt = `Use the Greenmark Store blueprint before changing Greenmark websites or agent workflows.

Start:
- identify the exact Greenmark property and authority surface
- identify whether the action is read-only or approval-required
- choose the relevant skill domain
- collect proof in Linear before calling the work done

Read:
${greenmarkStore.live.markdown}
${greenmarkStore.live.contract}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Storemetheus</title>
    <meta
      name="description"
      content="A no-secret blueprint for Greenmark's private, skills-first plugin store."
    />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" href="/logo.svg" />
  </head>
  <body>
    <main>
      <nav class="topline" aria-label="Greenmark store links">
        <a class="brand" href="/">
          <img src="/logo.svg" alt="" />
          <span>Storemetheus</span>
        </a>
        <div>
          <a href={greenmarkStore.routes.markdown}>Markdown</a>
          <a href={greenmarkStore.routes.contract}>JSON</a>
          <a href={canonicalUrls.repo}>Repo</a>
        </div>
      </nav>

      <header class="hero">
        <section>
          <p class="label">{greenmarkStore.visibility}</p>
          <h1>Greenmark Store</h1>
          <p class="lede">
            A private plugin-store blueprint for Greenmark operators and approved agents. It starts
            with skills, approval boundaries, and proof before software wrappers.
          </p>
          <div class="actions">
            <a class="button primary" href={greenmarkStore.routes.markdown}>Agent markdown</a>
            <a class="button" href={greenmarkStore.routes.caseStudy}>Case study</a>
          </div>
        </section>
        <aside aria-label="Store identity">
          <dl>
            <div>
              <dt>Owner</dt>
              <dd>{greenmarkStore.owner}</dd>
            </div>
            <div>
              <dt>Creator</dt>
              <dd>{greenmarkStore.creator}</dd>
            </div>
            <div>
              <dt>Audience</dt>
              <dd>{greenmarkStore.audience}</dd>
            </div>
          </dl>
        </aside>
      </header>

      <section class="section" aria-labelledby="domains-heading">
        <div class="section-head">
          <p class="label">Initial domains</p>
          <h2 id="domains-heading">Start with the recurring work that already causes drift.</h2>
        </div>
        <div class="grid">
          {greenmarkStore.domains.map((domain) => (
            <article>
              <h3>{domain}</h3>
            </article>
          ))}
        </div>
      </section>

      <section class="section split" aria-labelledby="skills-heading">
        <div>
          <p class="label">Skills first</p>
          <h2 id="skills-heading">Assets before software.</h2>
          <p>
            The store should prove repeatable Greenmark behavior with skills, guides, and evidence
            loops before turning anything into a heavier service.
          </p>
        </div>
        <div class="stack">
          {greenmarkStore.firstSkills.map((skill) => (
            <article>
              <h3>{skill.name}</h3>
              <p>{skill.job}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section split" aria-labelledby="approval-heading">
        <div>
          <p class="label">Approval boundary</p>
          <h2 id="approval-heading">The store must know when the agent has to stop.</h2>
        </div>
        <div class="proof-list">
          {greenmarkStore.approvalRequiredFor.map((item) => <span>{item}</span>)}
        </div>
      </section>

      <section class="section split" aria-labelledby="proof-heading">
        <div>
          <p class="label">Proof standard</p>
          <h2 id="proof-heading">Done means visible where work is judged.</h2>
        </div>
        <div class="proof-list">
          {greenmarkStore.proofSurfaces.map((surface) => <span>{surface}</span>)}
        </div>
      </section>

      <section class="section prompt" aria-labelledby="agent-heading">
        <div>
          <p class="label">Agent start</p>
          <h2 id="agent-heading">Use this prompt before Greenmark store work.</h2>
        </div>
        <pre><code>{agentPrompt}</code></pre>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --bg: #f4f6f1;
    --ink: #17201b;
    --muted: #5d675f;
    --line: rgba(23, 32, 27, 0.16);
    --panel: #fffefa;
    --accent: #1f5b44;
    --accent-2: #8b4a2c;
    --mono: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    letter-spacing: 0;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  main {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
  }

  .topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 22px 0;
    font-family: var(--mono);
    font-size: 0.82rem;
  }

  .topline div,
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
  }

  .brand img {
    width: 28px;
    height: 28px;
  }

  .hero {
    display: grid;
    min-height: 74vh;
    grid-template-columns: minmax(0, 1.05fr) minmax(300px, 0.95fr);
    gap: clamp(28px, 7vw, 84px);
    align-items: center;
    padding: 48px 0 76px;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    max-width: 10ch;
    margin-bottom: 24px;
    font-size: clamp(4rem, 9vw, 7.5rem);
    line-height: 0.92;
    letter-spacing: 0;
  }

  h2 {
    max-width: 780px;
    font-size: clamp(2rem, 4.5vw, 4.2rem);
    line-height: 1;
    letter-spacing: 0;
  }

  h3 {
    margin-bottom: 10px;
    font-size: 1.02rem;
    letter-spacing: 0;
  }

  .label,
  dt {
    color: var(--accent-2);
    font-family: var(--mono);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .lede {
    max-width: 650px;
    color: var(--muted);
    font-size: 1.18rem;
    line-height: 1.65;
  }

  .button {
    min-height: 42px;
    padding: 11px 15px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: rgba(255, 254, 250, 0.78);
    font-family: var(--mono);
    font-size: 0.78rem;
  }

  .primary {
    background: var(--accent);
    color: #fffefa;
  }

  aside,
  article {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255, 254, 250, 0.7);
  }

  aside {
    padding: 28px;
  }

  dl {
    display: grid;
    gap: 22px;
    margin: 0;
  }

  dd {
    margin: 8px 0 0;
    color: var(--muted);
    line-height: 1.55;
  }

  .section {
    padding: clamp(56px, 9vw, 104px) 0;
    border-top: 1px solid var(--line);
  }

  .section-head p,
  .split p,
  article p {
    color: var(--muted);
    line-height: 1.7;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
    margin-top: 30px;
  }

  .grid article,
  .stack article {
    padding: 20px;
  }

  .split,
  .prompt {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(28px, 7vw, 76px);
    align-items: start;
  }

  .stack {
    display: grid;
    gap: 12px;
  }

  .proof-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .proof-list span {
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.76rem;
  }

  pre {
    overflow: auto;
    margin: 0;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #17201b;
    color: #fffefa;
    font-size: 0.84rem;
    line-height: 1.55;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  @media (max-width: 860px) {
    main {
      width: min(100% - 24px, 680px);
    }

    .topline,
    .hero,
    .grid,
    .split,
    .prompt {
      grid-template-columns: 1fr;
    }

    .topline {
      align-items: flex-start;
      flex-direction: column;
    }

    .hero {
      min-height: auto;
    }

    h1 {
      font-size: clamp(3.4rem, 18vw, 5.3rem);
    }
  }
</style>
